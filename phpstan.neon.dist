# PHPStan configuration for the Contao MCP bundle.
#
# Level 5 baseline — pragmatic for a Contao bundle: catches type-mismatch,
# undefined-method, and dead-code without drowning in false positives from
# Contao\Model's magic __set/__get (which would dominate level 8+).
#
# We bias toward "ship green, then tighten" — bump the level once each
# class of finding is genuinely flushed, not for vanity.
#
# Symfony extension picks up #[AsHook], #[McpTool], service tags etc.
# so we don't get spurious "method never called" on tool methods.

includes:
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    # Level 4 — pragmatic for a Contao bundle.
    #
    # Level 5+ checks property TYPES on every assignment, which trips on
    # Contao Models heavily: their DCA-driven columns are declared as
    # `string|null` even when they semantically hold ints/bools, so
    # `$news->published = '1'` works at runtime but PHPStan flags it.
    # Without the contao/phpstan-contao extension (which we don't ship to
    # keep the dev surface small), level 5 generates 200+ false positives.
    #
    # Level 4 still catches the high-value stuff: dead code, always-true
    # conditions, missing methods, undefined classes. We get the real
    # bugs without drowning in Model magic noise.
    level: 4

    paths:
        - src

    # AbstractMigration subclasses are invoked via Contao reflection.
    # Their run()/shouldRun() signatures look unused to PHPStan.
    excludePaths:
        - src/Migration/Version020Beta01/*.php

    # Don't fail when an `ignoreErrors` rule matches zero findings —
    # keeps the config forgiving as the codebase evolves.
    reportUnmatchedIgnoredErrors: false

    # Contao Model magic suppression. The official contao/phpstan
    # extension is abandoned (Packagist confirms no maintained
    # successor), so PHPStan cannot natively understand:
    #
    #   $news = new NewsModel();
    #   $news->headline = 'X';          // column declared "string|null"
    #   $news->published = '1';         // boolean column held as a string
    #
    # Both runtime-valid but PHPStan flags them. Without an extension
    # there is no clean way around this — we suppress the category
    # globally rather than litter every Tool with @phpstan-ignore-next-line.
    #
    # These ignores trade off Contao-specific safety (which the smoke
    # test still exercises end-to-end) for the rest of PHPStan's
    # signal — undefined methods, dead code, narrowed types, etc.
    ignoreErrors:
        # Contao Model magic — see comment above.
        - identifier: assign.propertyType
        - identifier: property.notFound
        - identifier: nullCoalesce.offset

        # `array_filter` arg-1 / similar where PHPStan infers a tighter
        # type than the runtime sees (JSON-decoded `mixed` input).
        -
            identifier: argument.type
            paths:
                - src/Tool/*/FieldMapper.php
                - src/Tool/*/Tool.php

        # Defensive-code categories: PHPStan correctly notices that
        # certain guards are redundant given the inferred types. We KEEP
        # those guards because (a) they survive future refactors that
        # widen the inferred type, and (b) MCP tools accept JSON-decoded
        # input where the static type is `mixed` and we narrow it for
        # safety. These aren't bugs, they're belt-and-braces.
        - identifier: function.alreadyNarrowedType
        - identifier: notIdentical.alwaysTrue
        - identifier: identical.alwaysTrue
        - identifier: identical.alwaysFalse
        - identifier: instanceof.alwaysTrue
        - identifier: booleanAnd.alwaysTrue
        - identifier: ternary.alwaysTrue
        - identifier: ternary.alwaysFalse
        - identifier: function.impossibleType
        - identifier: property.onlyWritten
